# Nexus Research - Environment Configuration
# Using Gemini Web2API (zero-cost, no API key needed)
# Based on: https://github.com/Sophomoresty/gemini-web2api

# LLM Settings
GROQ_API_KEY=unused
GROQ_MODEL=gemini-3.6-flash
GROQ_BASE_URL=http://localhost:8081/v1

# Agent-specific models
GROQ_MODEL_SCOUT=gemini-3.5-flash              # Fast queries
GROQ_MODEL_ANALYST=gemini-3.5-flash-thinking   # Deep analysis
GROQ_MODEL_CRITIC=gemini-3.5-flash-thinking    # Critical review
GROQ_MODEL_SCRIBE=gemini-3.5-flash-thinking    # Report writing

# Note: Start the Gemini Web2API server first:
#   cd gemini-web2api && python gemini_web2api.py
# Server will run on http://localhost:8081
